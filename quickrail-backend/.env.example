# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Postgres ---
# Either set DATABASE_URL, or the individual PG_* vars below.
DATABASE_URL=postgres://quickrail:quickrail@localhost:5432/quickrail
PGSSL=false

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Razorpay (test mode) ---
# Get these from https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# From Razorpay Dashboard > Settings > Webhooks (set the same secret there)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Convenience fee / GST config for pricing ---
CONVENIENCE_FEE_FLAT=17.70
GST_RATE_PERCENT=18

# --- QuickRail AI (all optional) ---
# Without ANTHROPIC_API_KEY the agent runs on its built-in rule-based parser. With it, Claude is used ONLY to
# parse the user's message into structured fields (never sees train/passenger data, never confirms or pays).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
# AI_DISABLE_LLM=false
AI_RATE_LIMIT_PER_MIN=30
AI_MAX_ADVANCE_DAYS=60
